{
  "name": "btc-minute",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "vite build",
    "synth": "npm run build && tsx infra/app.ts",
    "deploy": "tsx scripts/deploy.ts deploy",
    "bootstrap": "tsx scripts/deploy.ts bootstrap",
    "destroy": "tsx scripts/deploy.ts destroy",
    "test:integration": "tsx scripts/test-integration.ts",
    "generate:api": "openapi-typescript openapi.yaml -o src/shared/api.generated.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1147.0",
    "@aws-sdk/client-secrets-manager": "3.1147.0",
    "@aws-sdk/client-sqs": "3.1147.0",
    "@aws-sdk/client-ssm": "3.1147.0",
    "@aws-sdk/client-sts": "3.1147.0",
    "@aws-sdk/credential-providers": "3.1147.0",
    "@aws-sdk/lib-dynamodb": "3.1147.0",
    "@better-auth/core": "1.7.7",
    "@datar-platform/better-auth-dynamodb": "0.2.2",
    "@epilot/volt-ui": "1.3.14",
    "@tanstack/react-query": "5.104.1",
    "better-auth": "1.7.7",
    "decimal.js": "10.6.0",
    "express": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/aws-lambda": "8.10.164",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "aws-cdk": "2.1144.0",
    "aws-cdk-lib": "2.272.0",
    "constructs": "10.8.1",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
